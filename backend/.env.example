HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# PostgreSQL connection string (postgresql:// or postgres://)
# Required when running with PostgreSQL server.
# For staging/production: inject via secret manager, never commit.
DATABASE_URL=postgresql://staynest:change-me@127.0.0.1:5432/staynest

# Set to 1 for PostgreSQL hosted over the network.
# Node TLS verifies server certificate (rejectUnauthorized: true).
DATABASE_SSL=0

# Absolute path to CA certificate if database provider uses a private/custom CA.
# Leave empty if provider uses a publicly trusted certificate authority.
DATABASE_SSL_CA_FILE=

# In-memory development demo mode (PGlite): only valid when DATABASE_URL is unset and NODE_ENV != production.
STAYNEST_EMBEDDED_DEMO=0

# Comma-separated list of exact allowed Flutter web origins.
# Wildcard '*' is strictly prohibited. Example: https://app.example.com
CORS_ORIGINS=http://127.0.0.1:8090,http://127.0.0.1:8087

# Explicit permission required to run demo seed CLI (npm run seed). Prohibited in production.
ALLOW_DEMO_SEED=0

# Optional demo user password for local testing only. Never use in production.
SEED_DEMO_PASSWORD=
