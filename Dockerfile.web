# ==============================================================================
# Multi-stage Dockerfile for StayNest Flutter Web
# Stage 1: Build Flutter Web
# ==============================================================================
FROM ghcr.io/cirruslabs/flutter:stable AS builder

WORKDIR /app

# Cache Flutter dependencies
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

# Copy source code and assets
COPY lib ./lib
COPY web ./web
COPY assets ./assets

# Build Flutter Web for production
# Setting STAYNEST_API_URL to empty string enables relative API routing
# through the Nginx reverse proxy (eliminating CORS and port mismatch issues).
RUN flutter build web --release --dart-define=STAYNEST_API_URL=

# ==============================================================================
# Stage 2: Serve via Nginx
# ==============================================================================
FROM nginx:alpine AS runner

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build/web /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

